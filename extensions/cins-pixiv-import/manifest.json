{
  "manifest_version": 3,
  "name": "CINs · Pixiv → Autopilot",
  "version": "0.1.1",
  "description": "Quét artwork Pixiv (tab đang mở) và đẩy vào hàng đợi Autopilot CINs.",
  "icons": {
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "CINs · Pixiv import",
    "default_popup": "popup.html",
    "default_icon": {
      "64": "icon-64.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.pixiv.net/*",
    "https://pixiv.net/*",
    "https://www.cins.vn/*",
    "https://cin\u0073.vn/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
